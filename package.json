{
  "name": "dsh-gemini-widget",
  "version": "0.1.3",
  "description": "DSH 界面里的猫娘挂件，表情随会话状态切换（待机、思考、等你确认、回合结束），实时显示上下文占用、Token、缓存命中率、每轮花费与 DeepSeek 余额；需要授权或提问时发声冒泡提醒，输入框下方附紧凑统计栏，尺寸、音效与停靠可调。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "widget",
    "telemetry",
    "gemini",
    "neko",
    "context",
    "token"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Applepinea/dsh-gemini-widget.git"
  },
  "homepage": "https://github.com/Applepinea/dsh-gemini-widget#readme",
  "bugs": {
    "url": "https://github.com/Applepinea/dsh-gemini-widget/issues"
  },
  "author": "Applepinea",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node tests/run.mjs",
    "release": "node scripts/release.mjs",
    "pack:tgz": "npm pack"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "icon": "assets/icon.png"
}
